---
import Head from "@/layouts/Head.astro";
import AppShell from "@/layouts/dashboard/AppShell.astro";
import "@/styles/main.css";

export interface Props {
  title?: string;
  description?: string;
  pageTitle?: string;
  pageSubtitle?: string;
}

const { title, description, pageTitle, pageSubtitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <Head title={title} description={description} animations={false} />
  <body class="bg-body text-text">
    <AppShell pageTitle={pageTitle} pageSubtitle={pageSubtitle}>
      <slot />
    </AppShell>
  </body>
</html>
