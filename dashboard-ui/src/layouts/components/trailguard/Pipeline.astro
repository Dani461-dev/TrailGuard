---
import { pipelineSteps, modules, contracts } from "@/data/trailguard";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section id="alur" class="section scroll-mt-24">
  <div class="container">
    <SectionHeading
      badge="System pipeline"
      title='<strong>One pipeline</strong>, five steps'
      subtitle="All stages run inside LinuxONE. Steps communicate only through data-contract files — not internal APIs."
    />

    <div class="grid gap-5 lg:grid-cols-5">
      {
        pipelineSteps.map((step, i) => (
          <article class="relative flex flex-col rounded-2xl border border-border bg-light p-6">
            <div class="mb-5 flex items-center justify-between">
              <span class="flex size-11 items-center justify-center rounded-xl bg-primary/12 text-primary">
                <Icon name={step.icon} class="size-5.5" />
              </span>
              <span class="font-secondary text-2xl font-bold text-text-dark/60">
                0{i + 1}
              </span>
            </div>
            <h3 class="mb-1 font-secondary text-h6 font-bold text-white">
              {step.title}
            </h3>
            <p class="mb-4 text-sm text-text">{step.desc}</p>
            <div class="mt-auto space-y-2 border-t border-border pt-4">
              <code class="block font-mono text-xs text-primary">
                {step.cmd}
              </code>
              <span class="block font-mono text-[0.7rem] leading-5 text-text-dark">
                {step.output}
              </span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-20 grid gap-x-16 gap-y-12 lg:grid-cols-2">
      <div>
        <h3 class="mb-6 font-secondary text-h5 font-bold text-white">
          Modules inside the repo
        </h3>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            modules.map((m) => (
              <div class="flex gap-4 rounded-xl border border-border bg-light/60 p-5">
                <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg bg-white/5 text-primary">
                  <Icon name={m.icon} class="size-4.5" />
                </span>
                <div class="min-w-0">
                  <p class="font-secondary text-sm font-semibold text-white">
                    {m.title}
                  </p>
                  <code class="block font-mono text-[0.7rem] text-primary/80">
                    {m.path}
                  </code>
                  <p class="mt-1.5 text-xs leading-5 text-text">{m.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="mb-6 font-secondary text-h5 font-bold text-white">
          Cross-group data contracts
        </h3>
        <div class="space-y-3">
          {
            contracts.map((c) => (
              <div class="rounded-xl border border-border bg-light/60 p-5">
                <div class="mb-2 flex items-center gap-3">
                  <span class="rounded-md bg-primary/15 px-2 py-0.5 font-mono text-xs font-semibold text-primary">
                    {c.id}
                  </span>
                  <code class="truncate font-mono text-xs text-text-light">
                    {c.file}
                  </code>
                </div>
                <p class="text-xs leading-5 text-text">{c.note}</p>
                <p class="mt-2 text-[0.7rem] text-text-dark">
                  {c.maker} <span class="text-primary">→</span> {c.consumer}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
