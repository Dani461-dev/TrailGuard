---
import { dod, deferred } from "@/data/trailguard";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section id="dod" class="section scroll-mt-24">
  <div class="container">
    <SectionHeading
      badge="Definition of Done"
      title='Done means <strong>measurable</strong>'
      subtitle="The project counts as finished when this list is met — all at the system level (not just a plan)."
    />

    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2 rounded-3xl border border-border bg-light p-8">
        <h3 class="mb-6 flex items-center gap-3 font-secondary text-h5 font-bold text-white">
          <Icon name="check" class="size-6 text-primary" />
          Definition of Done
        </h3>
        <ul class="space-y-4">
          {
            dod.map((item) => (
              <li class="flex gap-4">
                <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md border border-primary/40 bg-primary/10 text-primary">
                  <Icon name="check" class="size-3.5" />
                </span>
                <span class="text-sm leading-6 text-text-light">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-3xl border border-border bg-light/50 p-8">
        <h3 class="mb-2 flex items-center gap-3 font-secondary text-h6 font-bold text-white">
          <Icon name="clock" class="size-5 text-sky-300" />
          Deferred after Gate 3
        </h3>
        <p class="mb-5 text-xs text-text-dark">
          No owner yet; discussed together once the system is complete.
        </p>
        <ul class="space-y-3">
          {
            deferred.map((item) => (
              <li class="flex gap-3 text-sm text-text">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-400/70" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
